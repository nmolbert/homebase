// Home Base — Cloudflare Worker config.
// One Worker serves the app (static files in public/), the API, the calendar
// feed and push notifications. All data lives in ONE Durable Object ("the
// household") backed by SQLite, so there is no database to create by hand:
// `wrangler deploy` (run by Cloudflare's Git integration) creates it.
{
  "name": "homebase",
  "main": "src/worker.ts",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/ics/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "HOUSEHOLD", "class_name": "Household" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Household"] }],
  "triggers": { "crons": ["0 * * * *"] },
  "observability": { "enabled": true },
  "vars": {
    // Optional. Set RESEND_API_KEY as a *secret* in the dashboard to enable email.
    "EMAIL_FROM": "Home Base <onboarding@resend.dev>",
    "PUBLIC_URL": "https://homebase.nmolbert.workers.dev"
  }
}
